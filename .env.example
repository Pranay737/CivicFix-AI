# ==============================================================================
# CivicFix AI – Environment Configuration Template
# Copy this file to .env and configure with your credentials.
# Note: CivicFix AI is designed with built-in zero-dependency fallbacks.
# If cloud credentials (Gemini, Cloudinary, Neon) are omitted, the platform
# automatically activates local rule-based AI, local vector embeddings,
# local disk file storage, and in-memory H2 database.
# ==============================================================================

# Server Profile & Port
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL with pgvector)
# Free cloud PostgreSQL at: https://neon.tech
# Run query in Neon SQL Editor: CREATE EXTENSION IF NOT EXISTS vector;
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/civicfixdb?sslmode=require
DB_USERNAME=civicfix_user
DB_PASSWORD=your_neon_db_password

# ------------------------------------------------------------------------------
# 2. JWT SECURITY & TOKEN ROTATION
# Secret must be at least 256 bits (32+ characters)
# ------------------------------------------------------------------------------
JWT_SECRET=civicfix_ai_jwt_super_secret_key_2026_production_safe_token_generator_signature_key
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION (Free Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
# Powers structured issue triage and RAG embeddings (text-embedding-004)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (Free Tier)
# Free image hosting at: https://cloudinary.com
# If omitted, uploaded images fall back automatically to backend local disk storage (/uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. LOCAL FILE STORAGE & CORS SETTINGS
# ------------------------------------------------------------------------------
FILE_STORAGE_LOCAL_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
