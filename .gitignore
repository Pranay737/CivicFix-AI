# Environment files & Secrets (STRICT - NEVER COMMIT)
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Java / Maven build output
backend/target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Node / Vite frontend output
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/build/
**/build/
.npm
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded Files & Temporary Assets
backend/uploads/
**/uploads/
uploads/
*.tmp
*.temp

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

